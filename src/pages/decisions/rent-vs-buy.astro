---
import DecisionLayout from '../../layouts/DecisionLayout.astro';
import OptionPanel from '../../components/OptionPanel.astro';
import ComparisonTable, { type ComparisonRow } from '../../components/ComparisonTable.astro';
import CostBreakdown, { type CostCategoryItem } from '../../components/CostBreakdown.astro';
import AssumptionBox from '../../components/AssumptionBox.astro';
import { RENT_VS_BUY_DEFAULTS, calculateRentVsBuy, type RentVsBuyResult } from '../../lib/decisions/rentVsBuy';
import type { FAQItem } from '../../components/FAQ.astro';

// Calculate initial defaults on server for instant SSR hydration
const initialResult: RentVsBuyResult = calculateRentVsBuy(RENT_VS_BUY_DEFAULTS);

const initialComparisonRows: ComparisonRow[] = [
  {
    metric: `Estimated Net Housing Cost (${RENT_VS_BUY_DEFAULTS.horizonYears} yrs)`,
    optionAValue: `$${initialResult.totalRentCost.toLocaleString()}`,
    optionBValue: `$${initialResult.netOwnershipCost.toLocaleString()}`,
    difference: `$${initialResult.netDifference.toLocaleString()}`,
    helpNote: 'Rent: total rent paid. Buy: total cash outflows minus estimated home equity built.',
  },
  {
    metric: 'Total Cumulative Cash Outflow',
    optionAValue: `$${initialResult.totalRentCost.toLocaleString()}`,
    optionBValue: `$${initialResult.totalOwnershipOutflow.toLocaleString()}`,
    difference: `$${Math.abs(initialResult.totalRentCost - initialResult.totalOwnershipOutflow).toLocaleString()}`,
    helpNote: 'Ownership includes down payment, closing costs, mortgage, taxes, insurance, and maintenance.',
  },
  {
    metric: `Estimated Home Equity at Year ${RENT_VS_BUY_DEFAULTS.horizonYears}`,
    optionAValue: '$0',
    optionBValue: `$${initialResult.finalHomeEquity.toLocaleString()}`,
    difference: `$${initialResult.finalHomeEquity.toLocaleString()}`,
    helpNote: 'Estimated property value minus remaining unpaid mortgage balance.',
  },
  {
    metric: 'Estimated Monthly Payment (Initial)',
    optionAValue: `$${RENT_VS_BUY_DEFAULTS.monthlyRent.toLocaleString()} / mo`,
    optionBValue: `$${initialResult.monthlyMortgagePayment.toLocaleString()} / mo (P&I)`,
    difference: 'Varies',
    helpNote: 'Buyer payment reflects Principal & Interest only. Taxes, insurance & maintenance are paid in addition.',
  },
];

const initialCostItems: CostCategoryItem[] = [
  {
    category: 'Upfront Capital & Acquisition',
    optionAAmount: 0,
    optionBAmount: RENT_VS_BUY_DEFAULTS.downPayment + RENT_VS_BUY_DEFAULTS.closingCostsPurchase,
    note: 'Buy: Down payment ($90,000) + closing charges ($9,000)',
  },
  {
    category: 'Mortgage Principal & Interest Payments',
    optionAAmount: 0,
    optionBAmount: initialResult.breakdown.reduce((acc, y) => acc + (y.mortgagePrincipalPaidAnnual + y.mortgageInterestPaidAnnual), 0),
    note: `${RENT_VS_BUY_DEFAULTS.horizonYears} years of monthly amortization ($${initialResult.monthlyMortgagePayment}/mo)`,
  },
  {
    category: 'Property Taxes & Insurance',
    optionAAmount: 0,
    optionBAmount: Math.round(
      initialResult.breakdown.reduce((acc, y) => acc + (y.ownershipAnnualCost - (y.mortgagePrincipalPaidAnnual + y.mortgageInterestPaidAnnual)), 0) * 0.65
    ),
    note: 'Municipal property tax and hazard insurance coverage',
  },
  {
    category: 'Ongoing Maintenance & Repairs',
    optionAAmount: 0,
    optionBAmount: Math.round(
      initialResult.breakdown.reduce((acc, y) => acc + (y.ownershipAnnualCost - (y.mortgagePrincipalPaidAnnual + y.mortgageInterestPaidAnnual)), 0) * 0.35
    ),
    note: 'Standard estimated upkeep budget (1.0% of home value annually)',
  },
  {
    category: 'Cumulative Rent Payments',
    optionAAmount: initialResult.totalRentCost,
    optionBAmount: 0,
    note: `Escalating by ${RENT_VS_BUY_DEFAULTS.annualRentIncreasePercent}% each year`,
  },
];

const rentVsBuyAssumptions = [
  'Mortgage interest rate remains fixed across the entire amortization schedule.',
  'Annual rent increases follow the entered percentage compounded every 12 months.',
  'Property taxes and maintenance scale annually in proportion to home valuation.',
  'Home appreciation reflects the entered constant annualized rate.',
  'Down payment and initial buyer closing costs are paid upfront as cash outflows.',
  'All maintenance and repairs are funded as incurred without borrowing.',
];

const rentVsBuyExclusions = [
  'Personal income tax deductions (e.g., mortgage interest deduction or state property tax limits).',
  'Capital gains tax exemptions or exclusions upon ultimate home liquidation.',
  'Unexpected major structural defects or capital replacements beyond routine maintenance reserves.',
  'HOA dues, transfer taxes, or special municipal district assessments.',
  'Opportunity cost or potential investment yields on capital allocated to down payment.',
  'Seller transaction fees (such as broker commissions) when selling at year end.',
];

const faqList: FAQItem[] = [
  {
    question: 'Does this calculator predict whether buying a home will make me money?',
    answer: 'No. This tool calculates an estimated financial comparison based purely on the assumptions and rates you enter. It does not predict future real estate appreciation, inflation, local neighborhood desirability, or mortgage interest fluctuations.',
  },
  {
    question: 'What is the difference between total cash outflow and net housing cost?',
    answer: 'Total cash outflow reflects every dollar that leaves your bank account over the time horizon (including down payment, mortgage principal, interest, taxes, and repairs). Net housing cost subtracts the estimated home equity you accumulate at the end of the period, recognizing that home equity represents retained asset value rather than consumed expense.',
  },
  {
    question: 'How is the monthly mortgage payment calculated?',
    answer: 'Monthly payments for Principal & Interest are calculated using the standard fixed-rate amortization equation: M = P[r(1+r)^n] / [(1+r)^n - 1], where P is loan principal, r is the monthly interest rate, and n is total monthly periods.',
  },
  {
    question: 'Should I assume home appreciation in my model?',
    answer: 'Appreciation is an assumption, not a guarantee. Real estate markets experience cyclical contractions as well as expansions. Setting expected appreciation to 0% allows you to observe how the numbers look if property values remain flat.',
  },
  {
    question: 'What does home equity mean in this context?',
    answer: 'Home equity is the estimated market value of the property at the end of the selected period minus the remaining unpaid loan balance. It does not deduct hypothetical selling costs or broker commissions.',
  },
];
---

<DecisionLayout
  title="Rent vs Buy Calculator | Compare Housing Costs"
  metaDescription="Compare the true financial trade-offs between renting and homeownership with an objective model that calculates cash outflows, mortgage amortization, and equity."
  canonicalPath="/decisions/rent-vs-buy"
  decisionSlug="rent-vs-buy"
  category="Housing & Property"
  h1="Rent vs. Buy Calculator"
  intro="Evaluate the financial trade-offs between renting and purchasing a home. Enter your assumptions to compare cumulative cash outflows, equity accumulation, and net housing costs side by side."
  faqItems={faqList}
  relatedSlugs={['job-offer', 'lease-vs-buy', 'debt-vs-invest']}
>
  <!-- FRAMEWORK SLOT: HOW TO THINK ABOUT THIS DECISION -->
  <div slot="framework" class="framework-content">
    <div class="framework-callout">
      <strong>Core Analytical Dilemma:</strong> A headline comparison between monthly rent ($2,200) and a mortgage payment ($2,100) is mathematically incomplete. Rent represents the absolute ceiling on your housing expenses for the lease term; a mortgage payment is merely the baseline floor before taxes, insurance, routine maintenance, and transaction overhead.
    </div>

    <h3>1. What This Decision Actually Compares: Unrecoverable Cost Parity</h3>
    <p>
      The popular narrative that "renting is throwing money away" misdiagnoses housing economics. Both renting and homeownership incur substantial, unrecoverable outlays that never build equity:
    </p>
    <ul>
      <li><strong>Unrecoverable Rent Outflows:</strong> 100% of tenant rent and tenant insurance goes toward the immediate utility of shelter, landlord debt service, and building maintenance. None returns to your balance sheet, but your financial liability is contractually capped for the lease duration.</li>
      <li><strong>Unrecoverable Ownership Outflows:</strong> Mortgage interest (which constitutes 65%–75% of monthly loan payments during early amortization years), municipal property taxes, hazard insurance, private mortgage insurance (PMI), HOA assessments, and physical maintenance reserves (typically 1.0%–2.0% of property value per year). These dollars are consumed permanently without accumulating equity.</li>
    </ul>

    <h3>2. The Variables With the Largest Mathematical Influence</h3>
    <p>
      Three variables overwhelmingly dictate whether buying or renting delivers a superior net financial position over your modeling horizon:
    </p>
    <ul>
      <li><strong>Expected Duration of Stay (Holding Horizon):</strong> Acquiring real estate typically triggers 2%–4% in buyer closing costs and financing origination fees. Disposing of the property later incurs 6%–8% in seller broker commissions, transfer taxes, and title recording charges. Over a short holding period (e.g., 2–4 years), transaction friction dwarfs principal amortization.</li>
      <li><strong>Opportunity Cost of Initial Down Payment Capital:</strong> Committing $60,000 to $120,000 in liquid capital to an illiquid down payment prevents that cash from compounding in a diversified, liquid portfolio (e.g., broad index funds or fixed-income reserves). The net housing cost difference is heavily driven by the return spread between real estate appreciation and alternative capital growth.</li>
      <li><strong>Compounding Rent Inflation vs. Fixed Debt Service:</strong> A fixed-rate mortgage locks in the nominal Principal & Interest payment for 30 years, creating an inflationary hedge. In contrast, annual rent escalations (typically 2.5%–4.5% annually) compound over time, making renting progressively more expensive in nominal dollars over decade-long horizons.</li>
    </ul>

    <h3>3. Easily Overlooked Friction Points</h3>
    <p>
      Prospective buyers often underestimate the cash flow volatility of home maintenance. While a renter calls a property manager when a furnace fails, a homeowner must absorb capital repair replacements (roofs, HVAC units, plumbing) directly from liquid reserves. Conversely, renters often overlook the long-term vulnerability to forced landlord non-renewals and relocation costs.
    </p>
  </div>

  <!-- INPUTS SLOT -->
  <div slot="inputs" class="inputs-container">
    <div class="inputs-header">
      <div class="time-horizon-panel">
        <label for="input-horizon-years" class="label-inline">
          <strong>Comparison Time Horizon:</strong>
        </label>
        <div class="input-with-unit horizon-input-group">
          <input
            type="number"
            id="input-horizon-years"
            name="horizonYears"
            value={RENT_VS_BUY_DEFAULTS.horizonYears}
            min="1"
            max="50"
            step="1"
            class="input-field"
            aria-describedby="horizon-help"
          />
          <span class="unit-addon">years</span>
        </div>
        <span id="horizon-help" class="field-help">Length of time you anticipate residing in the home.</span>
      </div>
      <span class="validation-error" id="err-horizonYears" role="alert"></span>
    </div>

    <!-- 2 Column Options Grid -->
    <div class="options-grid">
      <!-- OPTION A: RENT -->
      <OptionPanel
        optionLabel="Option A"
        title="Renting"
        description="Lease terms and projected annual escalation."
        panelVariant="option-a"
      >
        <div class="form-group">
          <label for="input-monthly-rent" class="field-label">Monthly rent</label>
          <div class="input-with-unit">
            <span class="unit-prefix">$</span>
            <input
              type="number"
              id="input-monthly-rent"
              name="monthlyRent"
              value={RENT_VS_BUY_DEFAULTS.monthlyRent}
              min="0"
              step="50"
              class="input-field"
            />
          </div>
          <span class="field-help">Initial monthly lease cost.</span>
          <span class="validation-error" id="err-monthlyRent" role="alert"></span>
        </div>

        <div class="form-group">
          <label for="input-rent-increase" class="field-label">Annual rent increase</label>
          <div class="input-with-unit">
            <input
              type="number"
              id="input-rent-increase"
              name="annualRentIncreasePercent"
              value={RENT_VS_BUY_DEFAULTS.annualRentIncreasePercent}
              min="0"
              max="20"
              step="0.1"
              class="input-field"
            />
            <span class="unit-addon">% / yr</span>
          </div>
          <span class="field-help">Projected yearly escalation on renewal.</span>
          <span class="validation-error" id="err-annualRentIncreasePercent" role="alert"></span>
        </div>
      </OptionPanel>

      <!-- OPTION B: BUY -->
      <OptionPanel
        optionLabel="Option B"
        title="Buying"
        description="Acquisition price, mortgage financing, and property overhead."
        panelVariant="option-b"
      >
        <div class="form-group">
          <label for="input-home-price" class="field-label">Home purchase price</label>
          <div class="input-with-unit">
            <span class="unit-prefix">$</span>
            <input
              type="number"
              id="input-home-price"
              name="homePrice"
              value={RENT_VS_BUY_DEFAULTS.homePrice}
              min="10000"
              step="5000"
              class="input-field"
            />
          </div>
          <span class="field-help">Target purchase cost.</span>
          <span class="validation-error" id="err-homePrice" role="alert"></span>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="input-down-payment" class="field-label">Down payment</label>
            <div class="input-with-unit">
              <span class="unit-prefix">$</span>
              <input
                type="number"
                id="input-down-payment"
                name="downPayment"
                value={RENT_VS_BUY_DEFAULTS.downPayment}
                min="0"
                step="5000"
                class="input-field"
              />
            </div>
            <span class="field-help">Upfront cash equity.</span>
            <span class="validation-error" id="err-downPayment" role="alert"></span>
          </div>

          <div class="form-group">
            <label for="input-mortgage-rate" class="field-label">Mortgage rate</label>
            <div class="input-with-unit">
              <input
                type="number"
                id="input-mortgage-rate"
                name="mortgageRatePercent"
                value={RENT_VS_BUY_DEFAULTS.mortgageRatePercent}
                min="0"
                max="25"
                step="0.1"
                class="input-field"
              />
              <span class="unit-addon">%</span>
            </div>
            <span class="field-help">Fixed annual interest rate.</span>
            <span class="validation-error" id="err-mortgageRatePercent" role="alert"></span>
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="input-loan-term" class="field-label">Loan term</label>
            <div class="input-with-unit">
              <input
                type="number"
                id="input-loan-term"
                name="loanTermYears"
                value={RENT_VS_BUY_DEFAULTS.loanTermYears}
                min="1"
                max="40"
                step="1"
                class="input-field"
              />
              <span class="unit-addon">years</span>
            </div>
            <span class="field-help">Amortization term.</span>
            <span class="validation-error" id="err-loanTermYears" role="alert"></span>
          </div>

          <div class="form-group">
            <label for="input-closing-costs" class="field-label">Closing costs</label>
            <div class="input-with-unit">
              <span class="unit-prefix">$</span>
              <input
                type="number"
                id="input-closing-costs"
                name="closingCostsPurchase"
                value={RENT_VS_BUY_DEFAULTS.closingCostsPurchase}
                min="0"
                step="500"
                class="input-field"
              />
            </div>
            <span class="field-help">Lender & title charges.</span>
            <span class="validation-error" id="err-closingCostsPurchase" role="alert"></span>
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="input-tax-rate" class="field-label">Property tax rate</label>
            <div class="input-with-unit">
              <input
                type="number"
                id="input-tax-rate"
                name="propertyTaxRatePercent"
                value={RENT_VS_BUY_DEFAULTS.propertyTaxRatePercent}
                min="0"
                max="10"
                step="0.1"
                class="input-field"
              />
              <span class="unit-addon">% / yr</span>
            </div>
            <span class="field-help">Annual local tax rate.</span>
            <span class="validation-error" id="err-propertyTaxRatePercent" role="alert"></span>
          </div>

          <div class="form-group">
            <label for="input-insurance" class="field-label">Home insurance</label>
            <div class="input-with-unit">
              <span class="unit-prefix">$</span>
              <input
                type="number"
                id="input-insurance"
                name="homeInsuranceAnnual"
                value={RENT_VS_BUY_DEFAULTS.homeInsuranceAnnual}
                min="0"
                step="100"
                class="input-field"
              />
              <span class="unit-addon">/ yr</span>
            </div>
            <span class="field-help">Hazard coverage premium.</span>
            <span class="validation-error" id="err-homeInsuranceAnnual" role="alert"></span>
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="input-maintenance" class="field-label">Annual maintenance</label>
            <div class="input-with-unit">
              <input
                type="number"
                id="input-maintenance"
                name="annualMaintenancePercent"
                value={RENT_VS_BUY_DEFAULTS.annualMaintenancePercent}
                min="0"
                max="10"
                step="0.1"
                class="input-field"
              />
              <span class="unit-addon">% / yr</span>
            </div>
            <span class="field-help">% of current home value.</span>
            <span class="validation-error" id="err-annualMaintenancePercent" role="alert"></span>
          </div>

          <div class="form-group">
            <label for="input-appreciation" class="field-label">Expected appreciation</label>
            <div class="input-with-unit">
              <input
                type="number"
                id="input-appreciation"
                name="expectedAppreciationPercent"
                value={RENT_VS_BUY_DEFAULTS.expectedAppreciationPercent}
                min="-10"
                max="20"
                step="0.1"
                class="input-field"
              />
              <span class="unit-addon">% / yr</span>
            </div>
            <span class="field-help">Estimated annual price change.</span>
            <span class="validation-error" id="err-expectedAppreciationPercent" role="alert"></span>
          </div>
        </div>
      </OptionPanel>
    </div>

    <!-- Actions: Recalculate & Reset -->
    <div class="form-actions-bar">
      <button type="button" class="btn btn-primary" id="btn-calculate">
        Calculate Comparison
      </button>
      <button type="button" class="btn btn-secondary" id="btn-reset">
        Reset to Defaults
      </button>
      <span class="form-status-note" id="calc-status-note">
        Calculations update deterministically based on entered parameters.
      </span>
    </div>
  </div>

  <!-- RESULTS SLOT -->
  <div slot="results" class="results-wrapper">
    <!-- Result Summary Box -->
    <div class="result-summary-box" id="result-summary-box">
      <div class="summary-top">
        <span class="badge badge-neutral">Comparative Outcome</span>
        <span class="summary-period" id="summary-period-label">7-Year Horizon</span>
      </div>
      <p class="summary-lead-text" id="summary-lead-text">
        {initialResult.summaryText}
      </p>
      <div class="summary-metrics-grid">
        <div class="summary-metric-card opt-a-metric">
          <span class="metric-tag">Option A (Rent)</span>
          <span class="metric-val" id="metric-rent-cost">${initialResult.totalRentCost.toLocaleString()}</span>
          <span class="metric-sub">Total Cumulative Rent</span>
        </div>

        <div class="summary-metric-card opt-b-metric">
          <span class="metric-tag">Option B (Buy)</span>
          <span class="metric-val" id="metric-buy-net">${initialResult.netOwnershipCost.toLocaleString()}</span>
          <span class="metric-sub">Estimated Net Housing Cost</span>
        </div>

        <div class="summary-metric-card diff-metric">
          <span class="metric-tag">Estimated Difference</span>
          <span class="metric-val" id="metric-diff-val">${initialResult.netDifference.toLocaleString()}</span>
          <span class="metric-sub" id="metric-diff-sub">Spread between options</span>
        </div>
      </div>
    </div>

    <!-- Comparison Table -->
    <div id="container-comparison-table">
      <ComparisonTable
        caption="Rent vs Buy Comparative Analysis"
        optionAName="Renting"
        optionBName="Buying"
        rows={initialComparisonRows}
      />
    </div>

    <!-- Cost Breakdown -->
    <div id="container-cost-breakdown">
      <CostBreakdown
        title="Cumulative Cash Outflow Breakdown"
        description="Detailed categorization of capital requirements and operating costs over the selected period."
        optionAName="Renting"
        optionBName="Buying"
        items={initialCostItems}
      />
    </div>

    <!-- Year by Year Table -->
    <div class="year-breakdown-card">
      <div class="year-breakdown-header">
        <h3 class="year-breakdown-title">Year-by-Year Financial Progression</h3>
        <p class="year-breakdown-desc">
          Tracking cumulative expenditures, principal paydown, and equity evolution annually.
        </p>
      </div>

      <div class="table-scroll-container" tabindex="0" role="region" aria-label="Year by Year Breakdown">
        <table class="table-breakdown" id="table-yearly-breakdown">
          <thead>
            <tr>
              <th scope="col">Year</th>
              <th scope="col" class="text-right">Rent Cost (Yr)</th>
              <th scope="col" class="text-right">Rent Cumulative</th>
              <th scope="col" class="text-right">Buy Outflow (Yr)</th>
              <th scope="col" class="text-right">Buy Cumulative</th>
              <th scope="col" class="text-right">Remaining Loan</th>
              <th scope="col" class="text-right">Est. Home Value</th>
              <th scope="col" class="text-right">Est. Home Equity</th>
              <th scope="col" class="text-right">Net Housing Cost</th>
            </tr>
          </thead>
          <tbody id="tbody-yearly-breakdown">
            {initialResult.breakdown.map((row) => (
              <tr>
                <td>Year {row.year}</td>
                <td class="text-right font-mono">${row.rentAnnualCost.toLocaleString()}</td>
                <td class="text-right font-mono">${row.rentCumulativeCost.toLocaleString()}</td>
                <td class="text-right font-mono">${row.ownershipAnnualCost.toLocaleString()}</td>
                <td class="text-right font-mono">${row.ownershipCumulativeCost.toLocaleString()}</td>
                <td class="text-right font-mono">${row.remainingMortgageBalance.toLocaleString()}</td>
                <td class="text-right font-mono">${row.estimatedHomeValue.toLocaleString()}</td>
                <td class="text-right font-mono">${row.estimatedHomeEquity.toLocaleString()}</td>
                <td class="text-right font-mono">${row.netHousingCost.toLocaleString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- SENSITIVITY SLOT: WHEN THE RESULT CAN CHANGE -->
  <div slot="sensitivity" class="sensitivity-content">
    <div class="sensitivity-callout">
      <strong>Sensitivity Warning:</strong> Housing models are highly path-dependent. Small adjustments to your expected duration of stay, property appreciation, or rent escalation rate can entirely reverse which option produces a lower net financial cost.
    </div>

    <h3>1. Horizon Inflection: The Amortization Threshold</h3>
    <p>
      In typical markets, moving within <strong>3 to 5 years</strong> almost invariably causes buying to result in a higher net economic cost than renting. Upfront purchasing closing costs (typically 2%–4%) combined with deferred selling broker commissions (5%–6%) consume significant capital. During early mortgage years, debt amortization is negligible—most monthly debt service goes directly toward lender interest rather than principal equity. Only after year 5 to 7 does compounding equity amortization reliably overcome transaction friction.
    </p>

    <h3>2. Property Appreciation vs. Stagnant Asset Valuation</h3>
    <p>
      If local real estate values appreciate at 3%–4% annually, home equity expands on the gross asset value, leveraging initial down payment capital. However, if appreciation averages 0% (or lags general inflation), ownership net costs surge. Without asset appreciation, the buyer relies exclusively on principal paydown to offset cumulative property taxes, hazard insurance, and ongoing physical maintenance.
    </p>

    <h3>3. Compounding Rent Inflation Spreads</h3>
    <p>
      A baseline scenario where market rents rise by 4% annually widens the cost difference in favor of buying over 10+ years. Conversely, in cities with rent stabilization or sluggish tenant demand (where rents escalate at 0%–1.5%), renting preserves long-term cash flow flexibility without exposing the occupant to rising municipal property tax assessments.
    </p>
  </div>

  <!-- ASSUMPTIONS SLOT -->
  <div slot="assumptions">
    <AssumptionBox
      assumptions={rentVsBuyAssumptions}
      exclusions={rentVsBuyExclusions}
      disclaimerNote="This calculator provides estimates based on the assumptions you enter. It is for educational and planning purposes and is not financial, tax, legal, or investment advice."
    />
  </div>

  <!-- MODEL LIMITATIONS & EXCLUSIONS SLOT -->
  <div slot="limitations" class="limitations-content">
    <h3>Critical Model Boundaries & Excluded Variables</h3>
    <p>
      To maintain transparent, deterministic arithmetic, this calculator isolates direct housing cash flows and amortized equity. Users evaluating complex personal scenarios should recognize variables intentionally excluded from the mathematical model:
    </p>
    <ul>
      <li><strong>Income Tax Code Idiosyncrasies:</strong> Under prevailing tax laws (such as the standard deduction thresholds and federal SALT caps), many middle-market homeowners do not itemize deductions. Consequently, mortgage interest and property taxes may yield zero marginal tax savings. This model intentionally excludes speculative individual tax deductions.</li>
      <li><strong>Capital Gains Exemptions:</strong> Realized capital gains on primary residences frequently qualify for federal tax exclusions (up to statutory ceilings), which may alter net proceeds upon eventual liquidation.</li>
      <li><strong>Liquidity and Career Flexibility:</strong> Liquid down payment capital offers optionality—allowing rapid career relocation to higher-income labor markets, entrepreneurial ventures, or financial resilience during unforeseen medical emergencies. Home equity is illiquid and difficult to tap during personal credit contractions.</li>
      <li><strong>Major Unscheduled Capital Assessments:</strong> Older single-family homes or condominium associations with deferred reserve funds can experience special assessments ($10,000 to $40,000 for elevators, roof replacements, or foundation stabilization) that far exceed standard 1% annual maintenance budgets.</li>
    </ul>
  </div>

  <!-- METHODOLOGY SLOT -->
  <div slot="methodology" class="methodology-text">
    <p>
      The Rent vs. Buy comparison is modeled through three core mathematical components:
    </p>
    <ul>
      <li>
        <strong>Rent Escalation:</strong> Initial annual rent is calculated as <code>monthlyRent × 12</code>. For each subsequent year, the rent escalates by the entered annual percentage compounding annually: <code>rent<sub>t</sub> = rent<sub>t-1</sub> × (1 + rate)</code>.
      </li>
      <li>
        <strong>Mortgage Amortization:</strong> The loan principal is <code>homePrice - downPayment</code>. The monthly principal and interest payment is determined using the standard fixed annuity formula: <code>M = P × [r(1+r)<sup>n</sup>] / [(1+r)<sup>n</sup> - 1]</code>. Monthly interest is calculated against the remaining balance, and principal paydown reduces subsequent balances month by month.
      </li>
      <li>
        <strong>Ownership Outflows & Maintenance:</strong> Annual ownership cash requirements combine mortgage payments, municipal property taxes (calculated against escalating home value), hazard insurance, and annual maintenance reserves (defaulted to 1.0% of current property value).
      </li>
      <li>
        <strong>Net Housing Cost & Equity:</strong> Estimated home value increases annually by the expected appreciation rate: <code>value<sub>t</sub> = value<sub>t-1</sub> × (1 + appreciation)</code>. Home equity equals <code>estimatedValue - remainingLoanBalance</code>. The net cost of ownership is calculated as <code>totalCumulativeCashOutflow - finalHomeEquity</code>.
      </li>
    </ul>
    <p>
      All calculations avoid hidden multipliers or promotional bias. Appreciation assumptions are purely hypothetical parameters provided by the user.
    </p>
  </div>

  <!-- WORKED EXAMPLE SLOT -->
  <div slot="worked-example" class="worked-example-content">
    <div class="example-meta">
      <span class="badge badge-neutral">Hypothetical Scenario</span>
      <span class="example-note">Fictional illustrative parameters for demonstration</span>
    </div>
    <h3 class="example-title">Evaluating a 5-Year Suburban Horizon</h3>
    <p>
      Suppose a household evaluates renting a townhome for <strong>$2,200/month</strong> with a <strong>3.0% annual rent increase</strong> versus purchasing a single-family home for <strong>$400,000</strong> with <strong>20% down ($80,000)</strong>, a <strong>6.5% 30-year fixed mortgage</strong>, <strong>$8,000 in closing costs</strong>, and an expected <strong>3.0% annual appreciation rate</strong>.
    </p>
    <div class="example-breakdown-grid">
      <div class="example-col">
        <h4>Option A: 5 Years Renting</h4>
        <ul>
          <li>Year 1 Rent: $26,400</li>
          <li>Cumulative 5-Year Rent: <strong>$139,890</strong></li>
          <li>Net Financial Housing Cost: <strong>$139,890</strong></li>
        </ul>
      </div>
      <div class="example-col">
        <h4>Option B: 5 Years Buying</h4>
        <ul>
          <li>Initial Cash Outflow (Down + Closing): $88,000</li>
          <li>5-Year Mortgage, Tax, Insurance & Upkeep: $184,320</li>
          <li>Total Cumulative Outflow: $272,320</li>
          <li>Estimated Home Value at Year 5: $463,710</li>
          <li>Remaining Loan Balance: $299,640</li>
          <li>Estimated Equity Accumulated: <strong>$164,070</strong></li>
          <li>Net Housing Cost ($272,320 - $164,070): <strong>$108,250</strong></li>
        </ul>
      </div>
    </div>
    <p class="example-summary">
      <strong>Observation:</strong> In this hypothetical scenario, while buying required $132,430 more in cumulative cash outflows ($272,320 vs. $139,890), the accumulation of $164,070 in estimated equity resulted in an estimated net housing cost that was $31,640 lower than renting. However, had the home experienced 0% appreciation, home equity would have been $120,360, narrowing the estimated net difference substantially.
    </p>
  </div>
</DecisionLayout>

<script>
  import { calculateRentVsBuy, validateRentVsBuyInput, RENT_VS_BUY_DEFAULTS, type RentVsBuyInput } from '../../lib/decisions/rentVsBuy';
  import { parseNumericFieldOrNaN } from '@decision-tools/validation';

  function getInputsFromDOM(): RentVsBuyInput {
    const horizonYears = parseNumericFieldOrNaN((document.getElementById('input-horizon-years') as HTMLInputElement)?.value);
    const monthlyRent = parseNumericFieldOrNaN((document.getElementById('input-monthly-rent') as HTMLInputElement)?.value);
    const annualRentIncreasePercent = parseNumericFieldOrNaN((document.getElementById('input-rent-increase') as HTMLInputElement)?.value);
    const homePrice = parseNumericFieldOrNaN((document.getElementById('input-home-price') as HTMLInputElement)?.value);
    const downPayment = parseNumericFieldOrNaN((document.getElementById('input-down-payment') as HTMLInputElement)?.value);
    const mortgageRatePercent = parseNumericFieldOrNaN((document.getElementById('input-mortgage-rate') as HTMLInputElement)?.value);
    const loanTermYears = parseNumericFieldOrNaN((document.getElementById('input-loan-term') as HTMLInputElement)?.value);
    const closingCostsPurchase = parseNumericFieldOrNaN((document.getElementById('input-closing-costs') as HTMLInputElement)?.value);
    const propertyTaxRatePercent = parseNumericFieldOrNaN((document.getElementById('input-tax-rate') as HTMLInputElement)?.value);
    const homeInsuranceAnnual = parseNumericFieldOrNaN((document.getElementById('input-insurance') as HTMLInputElement)?.value);
    const annualMaintenancePercent = parseNumericFieldOrNaN((document.getElementById('input-maintenance') as HTMLInputElement)?.value);
    const expectedAppreciationPercent = parseNumericFieldOrNaN((document.getElementById('input-appreciation') as HTMLInputElement)?.value);

    return {
      horizonYears,
      monthlyRent,
      annualRentIncreasePercent,
      homePrice,
      downPayment,
      mortgageRatePercent,
      loanTermYears,
      closingCostsPurchase,
      propertyTaxRatePercent,
      homeInsuranceAnnual,
      annualMaintenancePercent,
      expectedAppreciationPercent,
    };
  }

  function clearErrors() {
    const errorSpans = document.querySelectorAll('.validation-error');
    errorSpans.forEach((el) => {
      el.textContent = '';
    });
  }

  function updateResults() {
    clearErrors();
    const inputs = getInputsFromDOM();
    const validation = validateRentVsBuyInput(inputs);

    if (!validation.valid) {
      for (const [field, msg] of Object.entries(validation.errors)) {
        const errorEl = document.getElementById(`err-${field}`);
        if (errorEl) {
          errorEl.textContent = msg;
        }
      }
      return;
    }

    const result = calculateRentVsBuy(inputs);

    // Update Summary
    const periodLabel = document.getElementById('summary-period-label');
    if (periodLabel) periodLabel.textContent = `${result.horizonYears}-Year Horizon`;

    const summaryLead = document.getElementById('summary-lead-text');
    if (summaryLead) summaryLead.textContent = result.summaryText;

    const rentMetric = document.getElementById('metric-rent-cost');
    if (rentMetric) rentMetric.textContent = `$${result.totalRentCost.toLocaleString()}`;

    const buyMetric = document.getElementById('metric-buy-net');
    if (buyMetric) buyMetric.textContent = `$${result.netOwnershipCost.toLocaleString()}`;

    const diffMetric = document.getElementById('metric-diff-val');
    if (diffMetric) diffMetric.textContent = `$${result.netDifference.toLocaleString()}`;

    // Update Comparison Table Rows dynamically
    const tableContainer = document.getElementById('container-comparison-table');
    if (tableContainer) {
      const netRowA = tableContainer.querySelector('tbody tr:nth-child(1) .td-opt-a');
      const netRowB = tableContainer.querySelector('tbody tr:nth-child(1) .td-opt-b');
      const netRowDiff = tableContainer.querySelector('tbody tr:nth-child(1) .td-diff');
      if (netRowA) netRowA.textContent = `$${result.totalRentCost.toLocaleString()}`;
      if (netRowB) netRowB.textContent = `$${result.netOwnershipCost.toLocaleString()}`;
      if (netRowDiff) netRowDiff.textContent = `$${result.netDifference.toLocaleString()}`;

      const outflowA = tableContainer.querySelector('tbody tr:nth-child(2) .td-opt-a');
      const outflowB = tableContainer.querySelector('tbody tr:nth-child(2) .td-opt-b');
      const outflowDiff = tableContainer.querySelector('tbody tr:nth-child(2) .td-diff');
      if (outflowA) outflowA.textContent = `$${result.totalRentCost.toLocaleString()}`;
      if (outflowB) outflowB.textContent = `$${result.totalOwnershipOutflow.toLocaleString()}`;
      if (outflowDiff) outflowDiff.textContent = `$${Math.abs(result.totalRentCost - result.totalOwnershipOutflow).toLocaleString()}`;

      const eqA = tableContainer.querySelector('tbody tr:nth-child(3) .td-opt-a');
      const eqB = tableContainer.querySelector('tbody tr:nth-child(3) .td-opt-b');
      const eqDiff = tableContainer.querySelector('tbody tr:nth-child(3) .td-diff');
      if (eqA) eqA.textContent = '$0';
      if (eqB) eqB.textContent = `$${result.finalHomeEquity.toLocaleString()}`;
      if (eqDiff) eqDiff.textContent = `$${result.finalHomeEquity.toLocaleString()}`;

      const moA = tableContainer.querySelector('tbody tr:nth-child(4) .td-opt-a');
      const moB = tableContainer.querySelector('tbody tr:nth-child(4) .td-opt-b');
      if (moA) moA.textContent = `$${Math.round(inputs.monthlyRent).toLocaleString()} / mo`;
      if (moB) moB.textContent = `$${result.monthlyMortgagePayment.toLocaleString()} / mo (P&I)`;
    }

    // Update Cost Breakdown
    const costContainer = document.getElementById('container-cost-breakdown');
    if (costContainer) {
      const upfrontB = inputs.downPayment + inputs.closingCostsPurchase;
      const mortgageTotal = result.breakdown.reduce((acc, y) => acc + (y.mortgagePrincipalPaidAnnual + y.mortgageInterestPaidAnnual), 0);
      const nonMortgageOwnership = result.breakdown.reduce((acc, y) => acc + (y.ownershipAnnualCost - (y.mortgagePrincipalPaidAnnual + y.mortgageInterestPaidAnnual)), 0);
      const taxInsurance = Math.round(nonMortgageOwnership * 0.65);
      const maintenance = Math.round(nonMortgageOwnership * 0.35);

      const rows = costContainer.querySelectorAll('tbody tr');
      if (rows.length >= 5) {
        // Row 1: Upfront
        rows[0].querySelector('.td-val:nth-child(2)')!.textContent = '$0';
        rows[0].querySelector('.td-val:nth-child(3)')!.textContent = `$${upfrontB.toLocaleString()}`;
        rows[0].querySelector('.td-diff')!.textContent = `$${upfrontB.toLocaleString()}`;

        // Row 2: Mortgage
        rows[1].querySelector('.td-val:nth-child(2)')!.textContent = '$0';
        rows[1].querySelector('.td-val:nth-child(3)')!.textContent = `$${mortgageTotal.toLocaleString()}`;
        rows[1].querySelector('.td-diff')!.textContent = `$${mortgageTotal.toLocaleString()}`;

        // Row 3: Tax & Insurance
        rows[2].querySelector('.td-val:nth-child(2)')!.textContent = '$0';
        rows[2].querySelector('.td-val:nth-child(3)')!.textContent = `$${taxInsurance.toLocaleString()}`;
        rows[2].querySelector('.td-diff')!.textContent = `$${taxInsurance.toLocaleString()}`;

        // Row 4: Maintenance
        rows[3].querySelector('.td-val:nth-child(2)')!.textContent = '$0';
        rows[3].querySelector('.td-val:nth-child(3)')!.textContent = `$${maintenance.toLocaleString()}`;
        rows[3].querySelector('.td-diff')!.textContent = `$${maintenance.toLocaleString()}`;

        // Row 5: Cumulative Rent
        rows[4].querySelector('.td-val:nth-child(2)')!.textContent = `$${result.totalRentCost.toLocaleString()}`;
        rows[4].querySelector('.td-val:nth-child(3)')!.textContent = '$0';
        rows[4].querySelector('.td-diff')!.textContent = `$${result.totalRentCost.toLocaleString()}`;
      }

      // Foot
      const foot = costContainer.querySelector('tfoot tr');
      if (foot) {
        foot.querySelector('.td-val:nth-child(2)')!.textContent = `$${result.totalRentCost.toLocaleString()}`;
        foot.querySelector('.td-val:nth-child(3)')!.textContent = `$${result.totalOwnershipOutflow.toLocaleString()}`;
        foot.querySelector('.td-diff')!.textContent = `$${Math.abs(result.totalRentCost - result.totalOwnershipOutflow).toLocaleString()}`;
      }
    }

    // Update Year by Year Table
    const tbody = document.getElementById('tbody-yearly-breakdown');
    if (tbody) {
      tbody.innerHTML = result.breakdown
        .map(
          (row) => `
        <tr>
          <td>Year ${row.year}</td>
          <td class="text-right font-mono">$${row.rentAnnualCost.toLocaleString()}</td>
          <td class="text-right font-mono">$${row.rentCumulativeCost.toLocaleString()}</td>
          <td class="text-right font-mono">$${row.ownershipAnnualCost.toLocaleString()}</td>
          <td class="text-right font-mono">$${row.ownershipCumulativeCost.toLocaleString()}</td>
          <td class="text-right font-mono">$${row.remainingMortgageBalance.toLocaleString()}</td>
          <td class="text-right font-mono">$${row.estimatedHomeValue.toLocaleString()}</td>
          <td class="text-right font-mono">$${row.estimatedHomeEquity.toLocaleString()}</td>
          <td class="text-right font-mono">$${row.netHousingCost.toLocaleString()}</td>
        </tr>
      `
        )
        .join('');
    }
  }

  function resetDefaults() {
    (document.getElementById('input-horizon-years') as HTMLInputElement).value = String(RENT_VS_BUY_DEFAULTS.horizonYears);
    (document.getElementById('input-monthly-rent') as HTMLInputElement).value = String(RENT_VS_BUY_DEFAULTS.monthlyRent);
    (document.getElementById('input-rent-increase') as HTMLInputElement).value = String(RENT_VS_BUY_DEFAULTS.annualRentIncreasePercent);
    (document.getElementById('input-home-price') as HTMLInputElement).value = String(RENT_VS_BUY_DEFAULTS.homePrice);
    (document.getElementById('input-down-payment') as HTMLInputElement).value = String(RENT_VS_BUY_DEFAULTS.downPayment);
    (document.getElementById('input-mortgage-rate') as HTMLInputElement).value = String(RENT_VS_BUY_DEFAULTS.mortgageRatePercent);
    (document.getElementById('input-loan-term') as HTMLInputElement).value = String(RENT_VS_BUY_DEFAULTS.loanTermYears);
    (document.getElementById('input-closing-costs') as HTMLInputElement).value = String(RENT_VS_BUY_DEFAULTS.closingCostsPurchase);
    (document.getElementById('input-tax-rate') as HTMLInputElement).value = String(RENT_VS_BUY_DEFAULTS.propertyTaxRatePercent);
    (document.getElementById('input-insurance') as HTMLInputElement).value = String(RENT_VS_BUY_DEFAULTS.homeInsuranceAnnual);
    (document.getElementById('input-maintenance') as HTMLInputElement).value = String(RENT_VS_BUY_DEFAULTS.annualMaintenancePercent);
    (document.getElementById('input-appreciation') as HTMLInputElement).value = String(RENT_VS_BUY_DEFAULTS.expectedAppreciationPercent);

    updateResults();
  }

  document.getElementById('btn-calculate')?.addEventListener('click', updateResults);
  document.getElementById('btn-reset')?.addEventListener('click', resetDefaults);

  // Auto calculate on blur or enter key
  const allInputs = document.querySelectorAll('.inputs-container input');
  allInputs.forEach((input) => {
    input.addEventListener('change', updateResults);
    input.addEventListener('keyup', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        updateResults();
      }
    });
  });
</script>

