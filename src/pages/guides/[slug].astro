---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import RelatedCalculator from '../../components/RelatedCalculator.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import { GUIDES, type GuideItem } from '../../data/guides';
import { DECISIONS } from '../../data/decisions';

export function getStaticPaths() {
  return GUIDES.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: GuideItem;
}

const { guide } = Astro.props;
const relatedDecision = DECISIONS.find((d) => d.slug === guide.relatedDecisionSlug);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://decision-tools.org';
const guideUrl = `${siteUrl}/guides/${guide.slug}`;

/**
 * Resolves an ISO 8601 date string ONLY when backed by reliable, documented project data.
 * Does not fabricate days, timestamps, or convert month-level dates (e.g., 'September 2026')
 * into artificial dates merely to satisfy Schema requirements.
 */
function getReliableIsoDate(displayDate?: string, explicitIsoDate?: string): string | undefined {
  if (explicitIsoDate && /^\d{4}-\d{2}-\d{2}/.test(explicitIsoDate)) {
    return explicitIsoDate;
  }
  if (displayDate && /^\d{4}-\d{2}-\d{2}/.test(displayDate)) {
    return displayDate;
  }
  return undefined;
}

const isoPublishedDate = getReliableIsoDate(guide.publishDate, guide.publishDateIso);
const isoModifiedDate = getReliableIsoDate(guide.modifiedDate, guide.modifiedDateIso) || isoPublishedDate;

const articleSchema: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  url: guideUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': guideUrl,
  },
  ...(isoPublishedDate ? { datePublished: isoPublishedDate } : {}),
  ...(isoModifiedDate ? { dateModified: isoModifiedDate } : {}),
  author: {
    '@type': 'Organization',
    name: 'Decision Tools Analytical Team',
    url: `${siteUrl}/about`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Decision Tools',
    url: siteUrl,
  },
};

const structuredData: Record<string, any>[] = [articleSchema];

if (guide.faq && guide.faq.length > 0) {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guide.faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}
---

<BaseLayout
  title={`${guide.title} | Decision Tools`}
  description={guide.description}
  canonicalPath={`/guides/${guide.slug}`}
  ogType="article"
  structuredData={structuredData}
>
  <article class="guide-article" id={`guide-article-${guide.slug}`} data-guide-slug={guide.slug} data-guide-name={guide.title}>
    <div class="container">
      <div class="guide-breadcrumbs">
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: 'Decision Guides', href: '/guides' },
            { label: guide.shortTitle },
          ]}
        />
      </div>

      <header class="article-header">
        <div class="article-meta">
          <span class="badge badge-neutral">{guide.topicTag}</span>
          <span class="article-read-time">{guide.readTime}</span>
          <span class="article-date">Published {guide.publishDate}</span>
          {guide.modifiedDate && (
            <span class="article-modified">· Updated {guide.modifiedDate}</span>
          )}
        </div>

        <h1 class="article-title">{guide.title}</h1>
        <p class="article-lead">{guide.description}</p>
      </header>

      <!-- Key Takeaways Box -->
      <div class="takeaways-card" id="takeaways-summary">
        <h2 class="takeaways-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 11 12 14 22 4"></polyline>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
          </svg>
          Key Decision Takeaways
        </h2>
        <ul class="takeaways-list">
          {guide.summaryPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>

      <!-- Main Article Body -->
      <div class="article-layout">
        <div class="article-body">
          {guide.contentSections.map((section, sIdx) => (
            <section class="article-section" id={`guide-section-${sIdx}`}>
              <h2 class="section-title">{section.heading}</h2>
              {section.paragraphs.map((p) => (
                <p class="section-paragraph" set:html={p} />
              ))}
              {section.bullets && section.bullets.length > 0 && (
                <ul class="section-bullets">
                  {section.bullets.map((b) => (
                    <li set:html={b} />
                  ))}
                </ul>
              )}
              {section.subparagraphs && section.subparagraphs.length > 0 && (
                section.subparagraphs.map((sp) => (
                  <p class="section-paragraph" set:html={sp} />
                ))
              )}
              {section.table && (
                <div class="table-wrapper">
                  <table class="article-table">
                    {section.table.caption && <caption class="table-caption">{section.table.caption}</caption>}
                    <thead>
                      <tr>
                        {section.table.headers.map((h) => (
                          <th scope="col">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {section.table.rows.map((row) => (
                        <tr>
                          {row.map((cell, cIdx) => (
                            cIdx === 0 ? <th scope="row" set:html={cell} /> : <td set:html={cell} />
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {section.callout && (
                <aside class="section-callout" role="note">
                  <span class="callout-icon" aria-hidden="true">💡</span>
                  <div class="callout-content">
                    <p set:html={section.callout} />
                  </div>
                </aside>
              )}
            </section>
          ))}

          <!-- Inline Calculator Callout -->
          {relatedDecision && (
            <RelatedCalculator decision={relatedDecision} variant="inline" />
          )}

          <!-- FAQ Accordion -->
          {guide.faq && guide.faq.length > 0 && (
            <section class="guide-faq-section" aria-labelledby="guide-faq-heading">
              <h2 class="sr-only" id="guide-faq-heading">Frequently Asked Questions</h2>
              <FAQ items={guide.faq} title="Decision Framework FAQ" />
            </section>
          )}

          <!-- Neutrality Statement -->
          <div class="neutrality-note" id="neutrality-policy">
            <h3>Our Non-Prescriptive Policy</h3>
            <p>
              Every decision involves unique personal priorities, regional living costs, risk appetites, and lifestyle requirements. We provide mathematical trade-off visibility so you can evaluate options without automated commercial recommendations.
            </p>
            <p style="margin-top: 0.5rem; font-size: 0.9rem;">
              Learn how we evaluate economic costs, opportunity value, and model boundaries in our <a href="/about#analytical-foundations" style="color: var(--color-brand-accent); font-weight: 500; text-decoration: underline;">Quantitative Methodology & Editorial Standards</a>.
            </p>
          </div>

          <!-- Related Decision Guides -->
          <RelatedGuides currentGuideSlug={guide.slug} title="Related Decision Guides" kicker="Further Analysis" />
        </div>

        <!-- Sticky Interactive Tool Sidebar -->
        {relatedDecision && (
          <aside class="article-sidebar">
            <RelatedCalculator decision={relatedDecision} variant="sidebar" />
          </aside>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .guide-article {
    padding: var(--space-8) 0 var(--space-16);
  }
  .guide-breadcrumbs {
    margin-bottom: var(--space-6);
  }
  .article-header {
    max-width: 820px;
    margin-bottom: var(--space-8);
  }
  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .article-title {
    font-size: 2.3rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }
  .article-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .takeaways-card {
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    margin-bottom: var(--space-10);
    max-width: 820px;
  }
  .takeaways-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: var(--space-4);
    color: var(--color-text-main);
  }
  .takeaways-list {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .takeaways-list li {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text-main);
  }
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }
  @media (min-width: 992px) {
    .article-layout {
      grid-template-columns: minmax(0, 760px) 320px;
    }
  }
  .article-section {
    margin-bottom: var(--space-8);
  }
  .section-title {
    font-size: 1.45rem;
    font-weight: 600;
    margin-bottom: var(--space-4);
    letter-spacing: -0.01em;
    color: var(--color-text-main);
  }
  .section-paragraph {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: var(--space-4);
  }
  .section-paragraph a,
  .section-bullets a,
  .callout-content a {
    color: var(--color-brand-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: color 0.15s ease;
  }
  .section-paragraph a:hover,
  .section-bullets a:hover,
  .callout-content a:hover {
    color: var(--color-brand-accent-hover, var(--color-brand-accent));
  }
  .section-bullets {
    margin: 0 0 var(--space-6);
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .section-bullets li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-main);
  }
  .table-wrapper {
    overflow-x: auto;
    margin: var(--space-6) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
  }
  .article-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }
  .table-caption {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    padding: var(--space-3) var(--space-4);
    text-align: left;
    background-color: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-border);
  }
  .article-table th,
  .article-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
    line-height: 1.5;
  }
  .article-table thead th {
    background-color: var(--color-surface-subtle);
    font-weight: 600;
    color: var(--color-text-main);
    border-bottom: 2px solid var(--color-border);
  }
  .article-table tbody tr:last-child th,
  .article-table tbody tr:last-child td {
    border-bottom: none;
  }
  .article-table tbody tr:hover {
    background-color: var(--color-surface-hover, rgba(0, 0, 0, 0.02));
  }
  .section-callout {
    display: flex;
    gap: var(--space-3);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-brand-accent);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
    margin: var(--space-6) 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .callout-icon {
    font-size: 1.2rem;
  }
  .guide-faq-section {
    margin: var(--space-8) 0;
  }
  .neutrality-note {
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    margin-top: var(--space-10);
  }
  .neutrality-note h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: var(--space-2);
    color: var(--color-text-main);
  }
  .neutrality-note p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }
  .article-sidebar {
    position: relative;
  }
</style>

<script>
  function initGuideAnalytics() {
    const article = document.querySelector('[data-guide-slug]');
    if (!article) return;

    const guideSlug = article.getAttribute('data-guide-slug') || '';
    const guideName = article.getAttribute('data-guide-name') || guideSlug;

    function track(eventName: string, params: Record<string, any> = {}) {
      if (typeof (window as any).trackDecisionEvent === 'function') {
        (window as any).trackDecisionEvent(eventName, params);
      } else if (Array.isArray((window as any).dataLayer)) {
        (window as any).dataLayer.push({ event: eventName, ...params });
      }
    }

    article.addEventListener('click', (e) => {
      const anchor = (e.target as HTMLElement)?.closest('a');
      if (!anchor) return;
      const href = anchor.getAttribute('href');
      if (href && href.startsWith('/decisions/')) {
        const calcSlug = href.replace('/decisions/', '').replace(/\/$/, '');
        if (!calcSlug || calcSlug === 'index') return;

        // Discover calculator name from nearest heading/badge or text content
        const calcTitle = anchor.querySelector('.calculator-tool-title, .callout-title')?.textContent?.trim() ||
                          anchor.textContent?.trim() ||
                          calcSlug;

        track('guide_to_calculator_click', {
          guide_slug: guideSlug,
          guide_name: guideName,
          calculator_slug: calcSlug,
          calculator_name: calcTitle,
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGuideAnalytics);
  } else {
    initGuideAnalytics();
  }
</script>
