---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const siteUrl = 'https://decision-tools.org';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy | Decision Tools',
  description: 'Understand how Decision Tools handles data: local browser computation for calculations, privacy-focused analytics, and advertising disclosure.',
  url: `${siteUrl}/privacy`,
};
---

<BaseLayout
  title="Privacy Policy | Decision Tools"
  description="Transparent data privacy policy: your calculator inputs stay in your browser and are never stored or transmitted. Learn about our analytics and advertising disclosure."
  canonicalPath="/privacy"
  structuredData={structuredData}
>
  <div class="legal-page">
    <div class="container">
      <div class="page-breadcrumbs">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Privacy Policy' }]} />
      </div>

      <header class="legal-header">
        <span class="legal-kicker">Data Transparency</span>
        <h1 class="legal-title">Privacy Policy</h1>
        <p class="legal-lead">
          At Decision Tools, we believe clarity and trust are essential. This policy explains what information we collect, what information we deliberately do not collect, and how third-party analytics and advertising operate on our website.
        </p>
        <div class="legal-meta">
          <span><strong>Effective Date:</strong> September 1, 2026</span>
          <span class="meta-separator">•</span>
          <span><strong>Last Updated:</strong> September 2026</span>
        </div>
      </header>

      <!-- Key Distinction Banner -->
      <section class="highlight-box">
        <div class="highlight-badge">Essential Privacy Distinction</div>
        <h2>Client-Side Calculator Processing vs. Analytics Tracking</h2>
        <p>
          We draw a strict boundary between <strong>your financial & personal calculation inputs</strong> and <strong>site analytics tracking</strong>:
        </p>
        <div class="distinction-grid">
          <div class="distinction-card safe">
            <div class="card-icon" aria-hidden="true">🔒</div>
            <h3>Your Calculator Inputs</h3>
            <p>
              When you enter salary figures, mortgage debts, purchase prices, or interest rates, those numbers are processed <strong>100% in your local web browser</strong>. They are never sent to our servers, never stored in any database, and never shared with third parties.
            </p>
          </div>
          <div class="distinction-card tracking">
            <div class="card-icon" aria-hidden="true">📊</div>
            <h3>Site Usage Analytics (GA4)</h3>
            <p>
              We use Google Analytics 4 to collect aggregated, non-personally identifiable traffic metrics (such as page views and general tool interaction events) to help us understand which guides and calculators are helpful and to maintain site reliability.
            </p>
          </div>
        </div>
      </section>

      <!-- Detailed Sections -->
      <div class="content-sections">
        <section class="policy-section">
          <h2>1. Information We Do NOT Collect</h2>
          <p>
            Unlike many financial portals, Decision Tools was intentionally architected without server-side input capture:
          </p>
          <ul>
            <li><strong>No User Account or Registration Data:</strong> We do not require accounts, logins, passwords, names, or email addresses to use any of our calculators or read our guides.</li>
            <li><strong>No Financial or Personal Input Storage:</strong> Every number you enter—including household income, loan balances, interest rates, rent payments, vehicle prices, and commute distances—is processed entirely in your device's browser memory (RAM) via deterministic client-side code.</li>
            <li><strong>No Input Transmission to Servers:</strong> Calculator inputs are not sent across the network to our servers or to external APIs.</li>
            <li><strong>No Financial Profiling or Lead Generation:</strong> We do not sell user-entered financial information to banks, mortgage brokers, auto dealerships, or insurance brokers.</li>
          </ul>
        </section>

        <section class="policy-section">
          <h2>2. Information We Collect Automatically</h2>
          <p>
            When you access <strong>https://decision-tools.org</strong>, certain non-sensitive technical and usage data is automatically gathered:
          </p>
          <ul>
            <li><strong>Google Analytics 4 (GA4):</strong> We use GA4 to analyze traffic trends. GA4 collects device information (browser type, operating system, screen resolution), approximate geographic region (city/region derived from masked IP addresses), referring URLs, pages visited, time spent per page, and general interaction milestones (such as whether a calculator was started, calculated, or reset).</li>
            <li><strong>Anonymized Analytics Parameters:</strong> When calculator events are dispatched to GA4, they contain strictly non-sensitive taxonomy identifiers (e.g., <code>calculator_slug: "rent-vs-buy"</code>). We explicitly prohibit and prevent user-entered numbers, financial inputs, or personal details from being sent to GA4.</li>
            <li><strong>Standard Technical Server & CDN Logs:</strong> Like standard web infrastructure, our hosting and content delivery network providers may temporarily log incoming HTTP requests (including request timestamps, HTTP status codes, and IP addresses) for technical troubleshooting, network optimization, and DDoS mitigation.</li>
          </ul>
        </section>

        <section class="policy-section">
          <h2>3. Cookies and Tracking Technologies</h2>
          <p>
            A cookie is a small text file placed on your device by your web browser. Decision Tools utilizes cookies for analytics and advertising purposes:
          </p>
          <ul>
            <li><strong>Analytics Cookies:</strong> Google Analytics uses cookies (such as <code>_ga</code> and <code>_ga_*</code>) to distinguish unique visitors across browsing sessions and compile aggregate traffic statistics. These cookies do not identify you personally.</li>
            <li><strong>Advertising Cookies (Google AdSense):</strong> As described below, Google AdSense uses cookies to serve relevant advertisements.</li>
          </ul>
        </section>

        <section class="policy-section">
          <h2>4. Google AdSense and Third-Party Advertising</h2>
          <p>
            Decision Tools displays advertisements provided by Google AdSense to help fund the hosting, maintenance, and ongoing development of our free calculators and educational guides.
          </p>
          <ul>
            <li><strong>Third-Party Vendor Cookies:</strong> Google, as a third-party vendor, uses cookies to serve ads on <code>decision-tools.org</code>.</li>
            <li><strong>DoubleClick / Advertising Cookies:</strong> Google's use of advertising cookies enables it and its partners to serve ads to our users based on their visit to our site and/or other sites on the Internet.</li>
            <li><strong>Authorized Digital Sellers (ads.txt):</strong> We maintain an authorized <code>ads.txt</code> file in compliance with the Interactive Advertising Bureau (IAB) standards at <a href="/ads.txt">https://decision-tools.org/ads.txt</a> confirming our publisher relationship (Publisher ID: <code>pub-1850854173653124</code>).</li>
            <li><strong>Personalized vs. Non-Personalized Ads:</strong> Depending on your jurisdiction and browser settings, ads displayed may be personalized based on your general interests or non-personalized based on page context.</li>
          </ul>
        </section>

        <section class="policy-section">
          <h2>5. Your Choices and Privacy Controls</h2>
          <p>
            You have full control over your browser cookies and analytics participation:
          </p>
          <ul>
            <li><strong>Opt Out of Personalized Advertising:</strong> You can opt out of personalized Google advertising by visiting <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer">Google Ads Settings</a>. You may also opt out of third-party vendor use of cookies for personalized advertising by visiting <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer">www.aboutads.info</a>.</li>
            <li><strong>Opt Out of Google Analytics:</strong> You can prevent Google Analytics from collecting your site activity by installing the official <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>.</li>
            <li><strong>Browser Cookie Management:</strong> Most modern web browsers allow you to block, delete, or manage cookies through their settings or privacy preferences. Disabling cookies will not affect your ability to use any calculator or read any guide on Decision Tools.</li>
            <li><strong>Google Privacy & Terms:</strong> To learn more about how Google handles information from sites that use its services, review <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">How Google uses information from sites or apps that use our services</a>.</li>
          </ul>
        </section>

        <section class="policy-section">
          <h2>6. Data Retention and Security</h2>
          <p>
            Aggregated analytics data collected via Google Analytics is retained in accordance with standard GA4 retention policies (typically 2 to 14 months) before automated deletion. Because we do not store calculator inputs or maintain user databases on our servers, there are no databases of user financial records or customer records stored by Decision Tools.
          </p>
        </section>

        <section class="policy-section">
          <h2>7. Links to External Websites</h2>
          <p>
            Our guides and educational resources may contain reference links to external third-party websites (such as government data sources like the IRS, Bureau of Labor Statistics, or EIA). We are not responsible for the privacy practices, content, or terms of third-party external websites. We encourage you to review the privacy policies of any site you visit.
          </p>
        </section>

        <section class="policy-section">
          <h2>8. Children's Privacy</h2>
          <p>
            Decision Tools is designed for general audiences interested in financial and practical decision modeling. We do not knowingly collect any personal information from children under 13 years of age.
          </p>
        </section>

        <section class="policy-section">
          <h2>9. Changes to This Privacy Policy</h2>
          <p>
            We may occasionally update this Privacy Policy to reflect improvements to our tools, legal requirements, or adjustments in analytics and advertising practices. Any updates will be published directly on this page with a revised "Last Updated" date.
          </p>
        </section>

        <section class="policy-section">
          <h2>10. Contacting Us About Privacy</h2>
          <p>
            If you have questions, feedback, or concerns regarding our privacy practices or the mathematical transparency of our tools, please visit our dedicated <a href="/contact">Contact Page</a> or review our <a href="/about">About & Methodology Page</a>.
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-page {
    padding: var(--space-8) 0 var(--space-16);
  }

  .page-breadcrumbs {
    margin-bottom: var(--space-6);
  }

  .legal-header {
    max-width: 820px;
    margin-bottom: var(--space-10);
  }

  .legal-kicker {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand-accent);
    margin-bottom: var(--space-2);
  }

  .legal-title {
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-main);
    margin-bottom: var(--space-4);
  }

  .legal-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .legal-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.9rem;
    color: var(--color-text-subtle);
  }

  .meta-separator {
    color: var(--color-border-strong);
  }

  .highlight-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-brand-accent);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    margin-bottom: var(--space-12);
    box-shadow: var(--shadow-sm);
  }

  .highlight-badge {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand-accent);
    margin-bottom: var(--space-2);
  }

  .highlight-box h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: var(--space-3);
  }

  .highlight-box > p {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .distinction-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .distinction-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .distinction-card {
    border-radius: var(--radius-md);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
  }

  .distinction-card.safe {
    background-color: var(--color-opt-b-bg);
    border-color: var(--color-opt-b-border);
  }

  .distinction-card.tracking {
    background-color: var(--color-opt-a-bg);
    border-color: var(--color-opt-a-border);
  }

  .card-icon {
    font-size: 1.8rem;
    margin-bottom: var(--space-3);
  }

  .distinction-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: var(--space-2);
    color: var(--color-text-main);
  }

  .distinction-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  .content-sections {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .policy-section {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
  }

  .policy-section h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: var(--space-4);
  }

  .policy-section p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .policy-section p:last-child {
    margin-bottom: 0;
  }

  .policy-section ul {
    margin: 0 0 var(--space-4) 0;
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .policy-section ul:last-child {
    margin-bottom: 0;
  }

  .policy-section li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .policy-section li strong {
    color: var(--color-text-main);
  }

  .policy-section a {
    color: var(--color-brand-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .policy-section a:hover {
    color: var(--color-brand-accent-hover);
  }

  .policy-section code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background-color: var(--color-surface-subtle);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }
</style>
