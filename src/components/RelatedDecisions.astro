---
import { DECISIONS } from '../data/decisions';
import type { DecisionItem } from '../types';

interface Props {
  currentSlug: string;
  relatedSlugs?: string[];
  maxCount?: number;
}

const {
  currentSlug,
  relatedSlugs,
  maxCount = 3,
} = Astro.props;

const ACTIVE_SLUGS = [
  'rent-vs-buy',
  'job-offer',
  'gas-vs-ev',
  'lease-vs-buy',
  'debt-vs-invest',
  'buy-vs-repair',
  'diy-vs-hire',
  'buy-vs-subscribe',
  'new-vs-used',
  'bulk-buy',
];

let matched: DecisionItem[] = [];

if (relatedSlugs && relatedSlugs.length > 0) {
  matched = relatedSlugs
    .map((s) => DECISIONS.find((d) => d.slug === s && ACTIVE_SLUGS.includes(d.slug)))
    .filter(Boolean) as DecisionItem[];
} else {
  matched = DECISIONS.filter((d) => d.slug !== currentSlug && ACTIVE_SLUGS.includes(d.slug)).slice(0, maxCount);
}
---

<div class="related-decisions-section">
  <div class="related-header">
    <span class="related-kicker">Related Analysis</span>
    <h3 class="related-title">Explore Related Decisions</h3>
  </div>

  <div class="related-grid">
    {matched.map((dec) => (
      <a href={`/decisions/${dec.slug}`} class="related-card" id={`related-decision-${dec.slug}`}>
        <div class="related-card-top">
          <span class="badge badge-neutral">{dec.category}</span>
          <span class="related-time">{dec.timeToEstimate}</span>
        </div>
        <h4 class="related-card-title">{dec.title}</h4>
        <p class="related-card-desc">{dec.description}</p>
        <span class="related-card-link">Compare {dec.optionAName} vs {dec.optionBName} →</span>
      </a>
    ))}
  </div>
</div>

<style>
  .related-decisions-section {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .related-header {
    margin-bottom: var(--space-5);
  }

  .related-kicker {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand-accent);
    display: block;
    margin-bottom: var(--space-1);
  }

  .related-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-text-main);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
  }

  .related-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    text-decoration: none;
    color: var(--color-text-main);
    transition: all 0.15s ease;
    box-shadow: var(--shadow-sm);
  }

  .related-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .related-card:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 2px;
  }

  .related-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .related-time {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
  }

  .related-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: var(--space-1);
    color: var(--color-text-main);
  }

  .related-card-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-3);
    flex-grow: 1;
  }

  .related-card-link {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-brand-accent);
  }
</style>
