---
import { getDecisionBySlug } from '../data/decisions';
import type { DecisionItem } from '../types';

interface Props {
  decisionSlug?: string;
  decision?: DecisionItem;
  variant?: 'sidebar' | 'inline';
}

const { decisionSlug, decision: inputDecision, variant = 'sidebar' } = Astro.props;
const decision = inputDecision || (decisionSlug ? getDecisionBySlug(decisionSlug) : undefined);
---

{decision && (
  variant === 'sidebar' ? (
    <aside class="sidebar-calculator-card" aria-label="Related Interactive Calculator" id={`calculator-sidebar-${decision.slug}`}>
      <span class="calculator-badge">Interactive Model</span>
      <h3 class="calculator-tool-title">{decision.title}</h3>
      <p class="calculator-tool-desc">{decision.tagline || decision.description}</p>
      
      <div class="calculator-metric-box">
        <span class="metric-label">Key Output Metric</span>
        <span class="metric-value">{decision.keyMetric}</span>
      </div>

      <a href={`/decisions/${decision.slug}`} class="btn btn-primary calculator-btn" id={`btn-calc-sidebar-${decision.slug}`}>
        Open Calculator ({decision.timeToEstimate})
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </aside>
  ) : (
    <section class="inline-calculator-callout" aria-label="Related Interactive Calculator" id={`calculator-callout-${decision.slug}`}>
      <div class="callout-header">
        <span class="calculator-badge">Interactive Calculation Tool</span>
        <h3 class="callout-title">{decision.title}</h3>
        <p class="callout-desc">{decision.tagline || decision.description}</p>
      </div>

      <div class="callout-action-row">
        <div class="callout-metric-group">
          <span class="metric-label">Primary Metric:</span>
          <span class="metric-value">{decision.keyMetric}</span>
        </div>
        <a href={`/decisions/${decision.slug}`} class="btn btn-primary" id={`btn-calc-inline-${decision.slug}`}>
          Calculate Your Numbers ({decision.timeToEstimate})
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </section>
  )
)}

<style>
  .calculator-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand-accent);
    display: block;
    margin-bottom: var(--space-2);
  }

  /* Sidebar Card Variant */
  .sidebar-calculator-card {
    position: sticky;
    top: calc(var(--header-height, 64px) + 24px);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .calculator-tool-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: var(--space-2);
    color: var(--color-text-main);
  }

  .calculator-tool-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-4);
  }

  .calculator-metric-box {
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .metric-label {
    display: block;
    font-size: 0.725rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .metric-value {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-top: var(--space-1);
    display: block;
  }

  .calculator-btn {
    width: 100%;
    justify-content: center;
  }

  /* Inline Callout Variant */
  .inline-calculator-callout {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-brand-accent);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    margin: var(--space-8) 0;
    box-shadow: var(--shadow-sm);
  }

  .callout-header {
    margin-bottom: var(--space-4);
  }

  .callout-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: var(--space-1) 0 var(--space-2);
    color: var(--color-text-main);
  }

  .callout-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .callout-action-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .callout-metric-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  @media (max-width: 640px) {
    .callout-action-row {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
