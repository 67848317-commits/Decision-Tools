---
export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  items: FAQItem[];
}

const {
  title = 'Frequently Asked Questions',
  items,
} = Astro.props;
---

<div class="faq-section" id="faq-section">
  <div class="faq-header">
    <span class="faq-kicker">Questions & Clarifications</span>
    <h3 class="faq-title">{title}</h3>
  </div>

  <div class="faq-list">
    {items.map((item, idx) => (
      <details class="faq-item" id={`faq-item-${idx}`}>
        <summary class="faq-question">
          <span>{item.question}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="faq-icon">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="faq-answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</div>

<style>
  .faq-section {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .faq-header {
    margin-bottom: var(--space-5);
  }

  .faq-kicker {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand-accent);
    display: block;
    margin-bottom: var(--space-1);
  }

  .faq-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-text-main);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .faq-item[open] {
    border-color: var(--color-border-strong);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-5);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-main);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    background-color: var(--color-surface-subtle);
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: -2px;
  }

  .faq-icon {
    color: var(--color-text-subtle);
    transition: transform 0.2s ease;
    flex-shrink: 0;
    margin-left: var(--space-3);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--space-5) var(--space-5) var(--space-5);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .faq-answer p {
    margin: 0;
  }
</style>
